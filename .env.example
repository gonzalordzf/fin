# Copy to .env and fill in — never commit the real .env (it's gitignored).

# DATABASE_URL=sqlite:///backend/finanzas.db

# BBVA statement PDFs/ZIPs are password-protected with the account
# holder's RFC, without the 3-character homoclave (e.g. RFC "ROFG950407NCA"
# -> password "ROFG950407").
BBVA_STATEMENT_PASSWORD=
