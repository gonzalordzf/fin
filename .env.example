# Copy to .env and fill in — never commit the real .env (it's gitignored).

# DATABASE_URL=sqlite:///backend/finanzas.db

# BBVA statement PDFs/ZIPs are password-protected with the account
# holder's RFC, without the 3-character homoclave (e.g. RFC "ROFG950407NCA"
# -> password "ROFG950407").
BBVA_STATEMENT_PASSWORD=

# Only needed for a real deployment (see DEPLOY.md) — local dev leaves both
# blank and the app runs with no login wall (see app/auth.py). Setting
# APP_PASSWORD is what turns the login requirement ON; SESSION_SECRET must
# be set alongside it or the app refuses to start. Generate SESSION_SECRET
# with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_PASSWORD=
SESSION_SECRET=

# production | (unset, default local). Only affects whether the session
# cookie is marked https-only — set to "production" in the real deploy.
APP_ENV=
